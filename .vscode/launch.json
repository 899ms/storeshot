{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: dev (bun)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "restart": true,
      "serverReadyAction": {
        "pattern": "Ready in|Local:.*http://localhost:3000",
        "uriFormat": "http://localhost:3000",
        "action": "openExternally"
      }
    },
    {
      "name": "Next.js: dev (npm)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "restart": true,
      "serverReadyAction": {
        "pattern": "Ready in|Local:.*http://localhost:3000",
        "uriFormat": "http://localhost:3000",
        "action": "openExternally"
      }
    }
  ]
}
